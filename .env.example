# Required: server-side Anthropic API key used by app/api/chat/route.ts.
# Never commit a real key — this file only documents the variable name.
ANTHROPIC_API_KEY=

# Optional: Langfuse tracing for cost/usage monitoring of chat completions
# (app/lib/langfuse.ts). Leave both blank to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional: Langfuse ingestion host. Defaults to https://cloud.langfuse.com
# when unset. Set this if your Langfuse Cloud project is in a different
# region, or if you're using a self-hosted Langfuse instance.
LANGFUSE_BASEURL=
