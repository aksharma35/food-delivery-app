# Required: server-side Anthropic API key used by app/api/chat/route.ts.
# Never commit a real key — this file only documents the variable name.
ANTHROPIC_API_KEY=

# Optional: Langfuse tracing for cost/usage monitoring of chat completions
# (instrumentation.ts + app/api/chat/route.ts, @langfuse/tracing SDK).
# Leave both blank to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional: Langfuse ingestion host. Defaults to https://cloud.langfuse.com
# (EU region) when unset. Use https://us.cloud.langfuse.com for the US
# region, or your self-hosted URL. Note the underscore in the name — this
# differs from the legacy v3 SDK's LANGFUSE_BASEURL.
LANGFUSE_BASE_URL=

# Required: Postgres connection string (used by lib/db.ts and scripts/seed.ts).
# Provision Postgres storage for this project in the Vercel dashboard
# (Storage tab) first — Vercel then injects a connection string under one of
# the names below. Check which one actually appears in your project's
# environment variables rather than assuming; only one needs to be set.
# A marketplace integration (e.g. Supabase) with a custom env var prefix
# names it STORAGE_POSTGRES_URL / STORAGE_POSTGRES_PRISMA_URL /
# STORAGE_POSTGRES_URL_NON_POOLING instead — lib/db.ts checks those too.
POSTGRES_URL=
DATABASE_URL=

# Required: fixed OTP code accepted for any phone number at the customer
# login flow (/login, app/api/login/route.ts) — demo mode, no real SMS
# provider is wired up. The phone entered must still match a seeded
# customers.phone value (see scripts/seed.ts). Never hardcode this in
# source. Suggested demo value: 9972
FOODLY_DEMO_OTP=

# Required: secret used to sign the session cookie (lib/session.ts). Use a
# long, random value, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
